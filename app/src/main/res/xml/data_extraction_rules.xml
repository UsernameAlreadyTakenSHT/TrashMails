<?xml version="1.0" encoding="utf-8"?>
<!-- Belt and braces behind allowBackup="false": on some devices the flag alone does not stop
     device-to-device transfer, and the inboxes preferences hold the mail.tm passwords. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
